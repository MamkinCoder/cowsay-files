#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 3 ]; then
  printf '%s\n' "Usage: ssh-add-user <host> <username> <ssh-public-key-or-.pub-file>" >&2
  exit 1
fi

host="$1"
username="$2"
key_input="$3"

if [ -f "$key_input" ]; then
  public_key="$(awk '/^ssh-/{print; exit}' "$key_input" | tr -d '\r')"
else
  public_key="$(printf '%s' "$key_input" | tr -d '\r')"
fi

# Validate full SSH public key shape: "algorithm payload [comment]".
if ! awk 'NF >= 2 && $1 ~ /^ssh-/ && length($2) > 40 {ok=1} END {exit(ok ? 0 : 1)}' <<<"$public_key"; then
  printf '%s\n' "Expected a full SSH public key or path to a .pub file" >&2
  exit 1
fi

public_key_b64="$(printf '%s' "$public_key" | base64 | tr -d '\n')"

ssh \
  -o PreferredAuthentications=publickey,keyboard-interactive,password \
  -o PubkeyAuthentication=yes \
  -- "$host" bash -s -- "$username" "$host" "$public_key_b64" <<'REMOTE'
set -euo pipefail

username="$1"
host="$2"
public_key_b64="$3"

decode_b64() {
  if command -v base64 >/dev/null 2>&1; then
    if base64 --decode </dev/null >/dev/null 2>&1; then
      base64 --decode
      return
    elif base64 -d </dev/null >/dev/null 2>&1; then
      base64 -d
      return
    fi
  fi

  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import base64,sys;sys.stdout.write(base64.b64decode(sys.stdin.read()).decode())'
    return
  fi

  if command -v openssl >/dev/null 2>&1; then
    openssl base64 -d -A
    return
  fi

  printf '%s\n' "No base64 decoder found on remote host." >&2
  exit 1
}

public_key="$(printf '%s' "$public_key_b64" | decode_b64)"

if [ "$(id -u)" = "0" ]; then
  as_root() {
    "$@"
  }
else
  if ! sudo -n true >/dev/null 2>&1; then
    printf '%s\n' "Passwordless sudo is required on $host for this script." >&2
    printf '%s\n' "Configure NOPASSWD for your current SSH user or connect as root." >&2
    exit 1
  fi
  as_root() {
    sudo -n "$@"
  }
fi

as_root_has_cmd() {
  as_root env PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH" \
    sh -c 'command -v "$1" >/dev/null 2>&1' sh "$1"
}

if ! id -u "$username" >/dev/null 2>&1; then
  if as_root_has_cmd adduser; then
    if as_root adduser --help 2>&1 | grep -q -- '--disabled-password'; then
      as_root adduser --disabled-password --gecos "" "$username"
    else
      as_root adduser "$username"
    fi
  elif as_root_has_cmd useradd; then
    as_root useradd -m -s /bin/bash "$username"
  else
    printf '%s\n' "Neither adduser nor useradd found on remote host." >&2
    exit 1
  fi
fi

if command -v getent >/dev/null 2>&1; then
  user_home="$(getent passwd "$username" | cut -d: -f6)"
else
  user_home="$(grep "^${username}:" /etc/passwd | cut -d: -f6)"
fi
if [ -z "$user_home" ]; then
  printf '%s\n' "Could not resolve home directory for user: $username" >&2
  exit 1
fi

if as_root sh -c 'getent group sudo >/dev/null 2>&1 || grep -q "^sudo:" /etc/group'; then
  as_root usermod -aG sudo "$username"
elif as_root sh -c 'getent group wheel >/dev/null 2>&1 || grep -q "^wheel:" /etc/group'; then
  as_root usermod -aG wheel "$username"
fi
as_root mkdir -p "$user_home/.ssh"

# Ensure key exists exactly once without clobbering existing keys.
as_root touch "$user_home/.ssh/authorized_keys"
if ! as_root grep -Fxq -- "$public_key" "$user_home/.ssh/authorized_keys"; then
  printf '%s\n' "$public_key" | as_root tee -a "$user_home/.ssh/authorized_keys" >/dev/null
fi

as_root chmod 700 "$user_home/.ssh"
as_root chmod 600 "$user_home/.ssh/authorized_keys"
as_root chown -R "$username:$username" "$user_home/.ssh"
as_root test -s "$user_home/.ssh/authorized_keys"
as_root mkdir -p /etc/sudoers.d
printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$username" | as_root tee "/etc/sudoers.d/$username" >/dev/null
as_root chmod 440 "/etc/sudoers.d/$username"
as_root visudo -c >/dev/null
as_root passwd -l "$username"

# Enforce key-only SSH auth for this specific user.
as_root mkdir -p /etc/ssh/sshd_config.d
cat <<EOF | as_root tee "/etc/ssh/sshd_config.d/99-${username}-keyonly.conf" >/dev/null
Match User ${username}
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  PubkeyAuthentication yes
  AuthenticationMethods publickey
EOF

# Validate config and reload SSH daemon.
if as_root_has_cmd sshd; then
  as_root sshd -t
elif as_root test -x /usr/sbin/sshd; then
  as_root /usr/sbin/sshd -t
else
  printf '%s\n' "Warning: sshd binary not found; skipping sshd config validation." >&2
fi

if as_root_has_cmd systemctl; then
  as_root systemctl reload ssh 2>/dev/null || as_root systemctl reload sshd
elif as_root_has_cmd service; then
  as_root service ssh reload 2>/dev/null || as_root service sshd reload
else
  printf '%s\n' "Warning: could not reload ssh service automatically. Reload sshd manually." >&2
fi
REMOTE

printf '%s\n' "Success: user provisioned and SSH key installed for $username on $host"
