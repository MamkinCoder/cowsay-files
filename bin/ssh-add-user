#!/bin/zsh
set -euo pipefail

if [[ $# -lt 3 ]]; then
  print -u2 "Usage: ssh-add-user <host> <username> <ssh-public-key-or-.pub-file>"
  exit 1
fi

host="$1"
username="$2"
key_input="$3"

if [[ -f "$key_input" ]]; then
  public_key="$(<"$key_input")"
else
  public_key="$key_input"
fi

if [[ "$public_key" != ssh-* ]]; then
  print -u2 "Expected an SSH public key or path to a .pub file"
  exit 1
fi

public_key_b64="$(printf '%s' "$public_key" | base64 | tr -d '\r\n')"

ssh -tt \
  -o PreferredAuthentications=publickey,keyboard-interactive,password \
  -o PubkeyAuthentication=yes \
  -- "$host" bash -s -- "$username" "$public_key_b64" <<'REMOTE'
set -euo pipefail

username="$1"
public_key_b64="$2"
public_key="$(printf '%s' "$public_key_b64" | base64 -d)"

if [[ "$(id -u)" == "0" ]]; then
  as_root() {
    "$@"
  }
else
  if ! sudo -n true >/dev/null 2>&1; then
    print -u2 "Passwordless sudo is required on $host for this script."
    print -u2 "Configure NOPASSWD for your current SSH user or connect as root."
    exit 1
  fi
  as_root() {
    sudo -n "$@"
  }
fi

if ! id -u "$username" >/dev/null 2>&1; then
  as_root adduser --disabled-password --gecos "" "$username"
fi

user_home="$(getent passwd "$username" | cut -d: -f6)"
if [[ -z "$user_home" ]]; then
  print -u2 "Could not resolve home directory for user: $username"
  exit 1
fi

as_root usermod -aG sudo "$username"
as_root mkdir -p "$user_home/.ssh"
printf '%s\n' "$public_key" | as_root tee "$user_home/.ssh/authorized_keys" >/dev/null
as_root chmod 700 "$user_home/.ssh"
as_root chmod 600 "$user_home/.ssh/authorized_keys"
as_root chown -R "$username:$username" "$user_home/.ssh"
as_root test -s "$user_home/.ssh/authorized_keys"
as_root mkdir -p /etc/sudoers.d
printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$username" | as_root tee "/etc/sudoers.d/$username" >/dev/null
as_root chmod 440 "/etc/sudoers.d/$username"
as_root visudo -c >/dev/null
as_root passwd -l "$username"
REMOTE
