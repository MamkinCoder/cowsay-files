#!/bin/zsh
set -euo pipefail

if [[ $# -lt 3 ]]; then
  print -u2 "Usage: ssh-add-user <host> <username> <ssh-public-key-or-.pub-file>"
  exit 1
fi

host="$1"
username="$2"
key_input="$3"

if [[ -f "$key_input" ]]; then
  public_key="$(<"$key_input")"
else
  public_key="$key_input"
fi

if [[ "$public_key" != ssh-* ]]; then
  print -u2 "Expected an SSH public key or path to a .pub file"
  exit 1
fi

public_key_b64="$(printf '%s' "$public_key" | base64)"

ssh -- "$host" bash -s -- "$username" "$public_key_b64" <<'REMOTE'
set -euo pipefail

username="$1"
public_key_b64="$2"
public_key="$(printf '%s' "$public_key_b64" | base64 -d)"

if [[ "$(id -u)" == "0" ]]; then
  as_root() {
    "$@"
  }
else
  as_root() {
    sudo "$@"
  }
fi

if ! id -u "$username" >/dev/null 2>&1; then
  as_root adduser --disabled-password --gecos "" "$username"
fi

as_root usermod -aG sudo "$username"
as_root mkdir -p "/home/$username/.ssh"
printf '%s\n' "$public_key" | as_root tee "/home/$username/.ssh/authorized_keys" >/dev/null
as_root chmod 700 "/home/$username/.ssh"
as_root chmod 600 "/home/$username/.ssh/authorized_keys"
as_root chown -R "$username:$username" "/home/$username/.ssh"
printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$username" | as_root tee "/etc/sudoers.d/$username" >/dev/null
as_root chmod 440 "/etc/sudoers.d/$username"
as_root passwd -l "$username"
REMOTE
