#!/bin/zsh
set -euo pipefail

if [[ $# -lt 3 ]]; then
  print -u2 "Usage: ssh-add-user <host> <username> <ssh-public-key-or-.pub-file>"
  exit 1
fi

host="$1"
username="$2"
key_input="$3"

if [[ -f "$key_input" ]]; then
  public_key="$(awk '/^ssh-/{print; exit}' "$key_input" | tr -d '\r')"
else
  public_key="$(print -r -- "$key_input" | tr -d '\r')"
fi

if [[ "$public_key" != ssh-* ]]; then
  print -u2 "Expected an SSH public key or path to a .pub file"
  exit 1
fi

ssh \
  -o PreferredAuthentications=publickey,keyboard-interactive,password \
  -o PubkeyAuthentication=yes \
  -- "$host" bash -s -- "$username" "$public_key" "$host" <<'REMOTE'
set -euo pipefail

username="$1"
public_key="$2"
host="$3"

if [[ "$(id -u)" == "0" ]]; then
  as_root() {
    "$@"
  }
else
  if ! sudo -n true >/dev/null 2>&1; then
    print -u2 "Passwordless sudo is required on $host for this script."
    print -u2 "Configure NOPASSWD for your current SSH user or connect as root."
    exit 1
  fi
  as_root() {
    sudo -n "$@"
  }
fi

if ! id -u "$username" >/dev/null 2>&1; then
  as_root adduser --disabled-password --gecos "" "$username"
fi

user_home="$(getent passwd "$username" | cut -d: -f6)"
if [[ -z "$user_home" ]]; then
  print -u2 "Could not resolve home directory for user: $username"
  exit 1
fi

as_root usermod -aG sudo "$username"
as_root mkdir -p "$user_home/.ssh"

# Ensure key exists exactly once without clobbering existing keys.
as_root touch "$user_home/.ssh/authorized_keys"
if ! as_root grep -Fxq -- "$public_key" "$user_home/.ssh/authorized_keys"; then
  printf '%s\n' "$public_key" | as_root tee -a "$user_home/.ssh/authorized_keys" >/dev/null
fi

as_root chmod 700 "$user_home/.ssh"
as_root chmod 600 "$user_home/.ssh/authorized_keys"
as_root chown -R "$username:$username" "$user_home/.ssh"
as_root test -s "$user_home/.ssh/authorized_keys"
as_root mkdir -p /etc/sudoers.d
printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$username" | as_root tee "/etc/sudoers.d/$username" >/dev/null
as_root chmod 440 "/etc/sudoers.d/$username"
as_root visudo -c >/dev/null
as_root passwd -l "$username"

# Enforce key-only SSH auth for this specific user.
as_root mkdir -p /etc/ssh/sshd_config.d
cat <<EOF | as_root tee "/etc/ssh/sshd_config.d/99-${username}-keyonly.conf" >/dev/null
Match User ${username}
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  PubkeyAuthentication yes
  AuthenticationMethods publickey
EOF

# Validate config and reload SSH daemon.
if as_root command -v sshd >/dev/null 2>&1; then
  as_root sshd -t
elif as_root test -x /usr/sbin/sshd; then
  as_root /usr/sbin/sshd -t
else
  print -u2 "Warning: sshd binary not found; skipping sshd config validation."
fi

if as_root command -v systemctl >/dev/null 2>&1; then
  as_root systemctl reload ssh 2>/dev/null || as_root systemctl reload sshd
elif as_root command -v service >/dev/null 2>&1; then
  as_root service ssh reload 2>/dev/null || as_root service sshd reload
else
  print -u2 "Warning: could not reload ssh service automatically. Reload sshd manually."
fi
REMOTE

# End-to-end validation: confirm the new user can actually log in with public key auth.
host_target="$host"
if [[ "$host_target" == *@* ]]; then
  host_target="${host_target#*@}"
fi
verify_target="${username}@${host_target}"

verify_ssh_opts=(
  -o BatchMode=yes
  -o PreferredAuthentications=publickey
  -o PubkeyAuthentication=yes
  -o PasswordAuthentication=no
  -o KbdInteractiveAuthentication=no
)
if [[ -f "$key_input" && "$key_input" == *.pub ]]; then
  private_key="${key_input%.pub}"
  if [[ -f "$private_key" ]]; then
    verify_ssh_opts+=(-i "$private_key")
  fi
fi

if ! ssh "${verify_ssh_opts[@]}" -- "$verify_target" true >/dev/null 2>&1; then
  print -u2 "Provisioning finished, but key login verification failed for $verify_target."
  print -u2 "Check authorized_keys content/permissions and run:"
  print -u2 "  ssh -vvv -o PreferredAuthentications=publickey -o PasswordAuthentication=no $verify_target"
  exit 2
fi

print "Success: key-only SSH login verified for $verify_target"
